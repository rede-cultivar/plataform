# Cultivar — ambiente local

# Ambiente: development ou production
CULTIVAR_ENV=development
CULTIVAR_HTTP_ADDR=:8080
CULTIVAR_HTTP_PORT=8080
CULTIVAR_LOCAL_DOMAIN=localhost:8080
CULTIVAR_INSTANCE_NAME=Cultivar
CULTIVAR_LOG_LEVEL=debug

# Segredo usado para sessões e chaves. Troque por um valor aleatório em produção.
CULTIVAR_SECRET_KEY=dev-only-secret-key-change-me-000000

# Banco de dados. A URL sem sufixo Docker é usada por `make run` no host.
CULTIVAR_DATABASE_URL=postgres://cultivar:cultivar@localhost:5432/cultivar?sslmode=disable
POSTGRES_USER=cultivar
POSTGRES_PASSWORD=cultivar
POSTGRES_DB=cultivar
POSTGRES_PORT=5432
# Compose substitui localhost pelo nome do serviço postgres.
CULTIVAR_DOCKER_DATABASE_URL=postgres://cultivar:cultivar@postgres:5432/cultivar?sslmode=disable

# Tempos
CULTIVAR_SHUTDOWN_TIMEOUT=15s
CULTIVAR_WORKER_POLL_INTERVAL=5s

# Sessões
CULTIVAR_SESSION_IDLE_TIMEOUT=12h
CULTIVAR_SESSION_ABSOLUTE_TIMEOUT=720h
# Em produção os cookies são sempre Secure; use true para testar HTTPS localmente.
CULTIVAR_COOKIE_SECURE=false

# Armazenamento de objetos compatível com S3
CULTIVAR_S3_ENDPOINT=localhost:9000
CULTIVAR_S3_REGION=us-east-1
CULTIVAR_S3_BUCKET=cultivar
CULTIVAR_S3_ACCESS_KEY=cultivar
CULTIVAR_S3_SECRET_KEY=cultivar123
CULTIVAR_S3_USE_SSL=false
S3MOCK_PORT=9000
# Compose substitui localhost pelo nome do serviço s3mock.
CULTIVAR_DOCKER_S3_ENDPOINT=s3mock:9090
